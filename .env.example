# CretPrep — AI Provider Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# Full URL to the AI provider's chat-completions endpoint.
# When set, the OpenAI-compatible adapter is used.
# Leave empty to use the built-in mock adapter (no real AI calls made).
VITE_AI_ENDPOINT=

# API key for the AI provider (optional when using mock adapter).
VITE_AI_API_KEY=

# Model name to use for generation (e.g. gpt-4o-mini, gpt-4o, azure-deployment-name).
VITE_AI_MODEL=gpt-4o-mini

# Request timeout in milliseconds (default: 30000).
VITE_AI_TIMEOUT_MS=30000

# Max tokens requested from provider for generated output (default: 8000).
VITE_AI_MAX_TOKENS=8000

# Max number of extracted characters sent to the AI provider (default: 12000).
VITE_AI_MAX_INPUT_CHARS=12000

# Max allowed PDF upload size in bytes (default: 921600 = 900 KB, less than 1 MB).
VITE_MAX_UPLOAD_BYTES=921600

# Set to true only if a short-lived serverless proxy is approved via constitution exception.
# MUST remain false unless a documented exception is in place.
VITE_ALLOW_SERVER_PROXY=false
